def text_to_video(prompt: str, output_path="output.mp4", duration=60):
    # Step 1: Generate Images (Stable Diffusion - Free Offline)
    pipe = StableDiffusionPipeline.from_pretrained("runwayml/stable-diffusion-v1-5")
    pipe.to("cuda" if torch.cuda.is_available() else "cpu")

    frames = []
    words = prompt.split()
    
    for i in range(0, len(words), 5):  # chunk text into scenes
        scene_prompt = " ".join(words[i:i+5]) + ", dark anime style"
        
        image = pipe(scene_prompt).images[0]
        frame_path = f"frame_{i}.png"
        image.save(frame_path)
        frames.append(frame_path)

    # Step 2: Voice Narration (Bark TTS - Free & Creepy AF)
    audio_array = generate_audio(prompt[:200], history_prompt="v2/en_speaker_6") # zombie whisper voice

    from scipy.io.wavfile import write as write_wav
    audio_path = "voice.wav"
    write_wav(audio_path, rate=24_000, data=audio_array)

    
