{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "salah-cloud",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "observability": {
    "enabled": true
  }
}