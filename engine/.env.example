# Generate a private token with: python -c "import secrets; print(secrets.token_urlsafe(40))"
API_TOKEN=replace_with_a_long_random_secret
# Set this to your domain before enabling the optional Caddy profile.
DOMAIN=your-domain.example
# Allowed origins for the separate GitHub Pages dashboard.
CORS_ORIGINS=https://salah-aser.github.io,http://localhost:8000,http://127.0.0.1:8000
# Do not put real secrets in GitHub or commit this file. Copy to .env on the server.
